#!/bin/bash
# Sourceable configuration for the paper-style MethylBERT OAC experiment.
#
# Fill in the absolute cluster paths below, then run:
#
#   source slurm/common.sh
#   export METHYLBERT_CONFIG="${PROJECT_DIR}/configs/methylbert_oac_paper.env"
#   python scripts/validate_methylbert_inputs.py --config "${METHYLBERT_CONFIG}" --check-tags
#   bash run_methylbert_paper_e2e_slurm.sh

export OUTPUT_DIR="${PROJECT_DIR}/runs/run_v0.5_methylbert"
export RUN_LABEL="OAC_methylbert_paper"

# Upstream MethylBERT source. This path is provided by the git submodule.
export METHYLBERT_DIR="${PROJECT_DIR}/external/methylbert"
export METHYLBERT_WORK_DIR="${OUTPUT_DIR}/methylbert/${RUN_LABEL}"

# Reference FASTA used for the BAM alignments. Must have a matching .fai.
export METHYLBERT_REF_FASTA=""

# Methylation tag parser used by upstream MethylBERT and the DSS count extractor.
# Use "bismark" for XM tags, or "dorado" for MM/ML modified-base tags.
export METHYLBERT_METHYLCALLER="bismark"

# Optional environment activation command. It must provide Python MethylBERT
# dependencies, pysam, R, DSS, and optparse.
# Example:
# export METHYLBERT_ENV_COMMAND='source ~/miniforge3/etc/profile.d/conda.sh && conda activate methylbert'
export METHYLBERT_ENV_COMMAND=""

# BAM list files. Each file is one absolute BAM/CRAM path per line.
#
# DMR calling:
#   T = tumour tissue BAMs
#   N = non-tumour/background BAMs used by DSS to discover tumour-specific DMRs
export METHYLBERT_DMR_TUMOUR_BAM_LIST="${PROJECT_DIR}/data/methylbert/oac_dmr_tumour_bams.list"
export METHYLBERT_DMR_NORMAL_BAM_LIST="${PROJECT_DIR}/data/methylbert/oac_dmr_normal_bams.list"

# MethylBERT read-classifier fine-tuning:
#   T = tumour tissue BAMs
#   N = healthy-control cfDNA BAMs
export METHYLBERT_TUMOUR_BAM_LIST="${PROJECT_DIR}/data/methylbert/oac_train_tumour_bams.list"
export METHYLBERT_CONTROL_BAM_LIST="${PROJECT_DIR}/data/methylbert/oac_train_control_cfdna_bams.list"

# Bulk/test cfDNA BAMs for tumour fraction estimation.
export METHYLBERT_BULK_BAM_LIST="${PROJECT_DIR}/data/methylbert/oac_bulk_cfdna_bams.list"

# DSS DMR calling settings from the paper.
export DMR_TOP_N=100
export DMR_DELTA=0.2
export DMR_P_THRESHOLD=0.05
export DMR_MIN_CPG=4
export DMR_MIN_LEN=50
export DMR_MERGE_DISTANCE=50
export MIN_MAPQ=10
export MIN_CPG_COVERAGE=1

# Upstream MethylBERT fine-tuning settings.
export N_ENCODER=12
export SEQ_LEN=150
export BATCH_SIZE=256
export GRAD_ACCUM=4
export STEPS=600
export NUM_WORKERS=8
export LOG_FREQ=10
export EVAL_FREQ=10
export WARM_UP=100
export DECREASE_STEPS=200
export LR=4e-4
export LOSS=bce
export WITH_CUDA=1

# Deconvolution.
export DECONV_BATCH_SIZE=128
export ADJUSTMENT=0
