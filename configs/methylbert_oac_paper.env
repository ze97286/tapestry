#!/bin/bash
# Sourceable configuration for the paper-style MethylBERT OAC experiment.
#
# Fill in the absolute cluster paths below, then run:
#
#   export PROJECT_DIR="$(pwd)"
#   export METHYLBERT_CONFIG="${PROJECT_DIR}/configs/methylbert_oac_paper.env"
#   python scripts/validate_methylbert_inputs.py --config "${METHYLBERT_CONFIG}" --check-tags
#   bash run_methylbert_paper_e2e_slurm.sh

export OUTPUT_DIR="${PROJECT_DIR}/runs/run_v0.5_methylbert"
export RUN_LABEL="OAC_methylbert_paper"

# Upstream MethylBERT source. This path is provided by the git submodule.
export METHYLBERT_DIR="${PROJECT_DIR}/external/methylbert"
export METHYLBERT_WORK_DIR="${OUTPUT_DIR}/methylbert/${RUN_LABEL}"

# Reference FASTA used for the BAM alignments.
#
# Use the shared compressed FASTA here. Jobs stage a temporary uncompressed
# FASTA under local scratch because upstream MethylBERT/Biopython does not
# reliably read .fa.gz directly.
export METHYLBERT_REF_FASTA=""
# export METHYLBERT_REF_FASTA_GZ="/well/ludwig/shared/genomes/hg38_full_gatk_HPV_HBV_HCV_spike-ins_v2.fa.gz"
export METHYLBERT_REF_FASTA_GZ="/mnt/lustre/users/ramess/ref/hg38+HPV+HBV+HVC+EBV+TAPS_SI/hg38_full_gatk_HPV_HBV_HCV_spike-ins.fa.gz"

# Optional shared staging directory. Leave empty to use per-job local scratch
# via $SLURM_TMPDIR.
export METHYLBERT_REF_STAGE_DIR=""

# Methylation tag parser used by upstream MethylBERT and the DSS count extractor.
# Use "bismark" for XM tags, or "dorado" for MM/ML modified-base tags.
export METHYLBERT_METHYLCALLER="bismark"

# Python venv used by the Slurm jobs for Python packages missing from modules
# such as pysam. R stays module-driven; use the same user-level R library
# pattern as the original deepconv runs.
export METHYLBERT_VENV="${OUTPUT_DIR}/envs/methylbert"
export METHYLBERT_R_LIBS="${HOME}/R/library"

# Optional environment activation command. It must provide Python MethylBERT
# dependencies, pysam, R, DSS, and optparse.
export METHYLBERT_ENV_COMMAND='source "${METHYLBERT_VENV}/bin/activate"; export R_LIBS_USER="${METHYLBERT_R_LIBS}"'

# Optional module bootstrap and environment modules to load before running jobs.
# If the cluster does not define `module` in non-interactive Slurm shells, set
# METHYLBERT_MODULE_INIT to the local module init script, e.g.
#   export METHYLBERT_MODULE_INIT='source /etc/profile.d/modules.sh'
export METHYLBERT_MODULE_INIT=""

# Optional extra module roots. Leave empty on cortex3: compute jobs already see
# the usable /opt module trees, while the /apps/eb tree shown interactively is
# not mounted on compute nodes.
export METHYLBERT_MODULE_USE=""

# Base modules loaded for every MethylBERT step. Keep empty unless every cluster
# running every step has the same module stack.
export METHYLBERT_MODULES=""

# DMR step modules. This step needs:
#   samtools                 for temporary FASTA indexing
#   R/Rscript with DSS,optparse for DMR calling
# Python/pysam is supplied by METHYLBERT_VENV unless you choose to provide it
# by module instead.
#
# Exact module names visible inside cortex3 Slurm jobs. The libxml2 module is
# needed for source-building the R XML package, which is pulled by DSS.
export METHYLBERT_DMR_MODULES="python/3.11.14/gcc-11.5.0/a-pvjgmcx r/4.5.2/gcc-15.2.0/a-itkcro5 libxml2/2.13.5/gcc-11.5.0/a-hx6xlb7 samtools/1.21/gcc-15.2.0/a-ofmrbeo"

# Optional modules loaded only while creating the venv/R library. Set this to
# the cluster's Python/R build modules if the system defaults are insufficient.
export METHYLBERT_SETUP_MODULES="${METHYLBERT_DMR_MODULES}"

# Venv install scope:
#   dmr  = immediate DMR dependencies only: pysam, pandas, numpy
#   full = editable upstream methylbert install with all Python dependencies
export METHYLBERT_VENV_SCOPE="dmr"
export METHYLBERT_SETUP_R_DEPS=1

# BAM list files. Each file is one absolute BAM/CRAM path per line.
#
# DMR calling:
#   T = tumour tissue BAMs
#   N = non-tumour/background BAMs used by DSS to discover tumour-specific DMRs
export METHYLBERT_DMR_TUMOUR_BAM_LIST="${PROJECT_DIR}/data/methylbert/oac_dmr_tumour_bams.list"
export METHYLBERT_DMR_NORMAL_BAM_LIST="${PROJECT_DIR}/data/methylbert/oac_dmr_normal_bams.list"

# PAT list files for DSS DMR calling when BAMs do not carry methylation tags.
# PATs should already be in bisulfite convention (C=methylated, T=unmethylated).
export METHYLBERT_DMR_TUMOUR_PAT_LIST="${PROJECT_DIR}/data/methylbert/oac_dmr_tumour_pats.list"
export METHYLBERT_DMR_NORMAL_PAT_LIST="${PROJECT_DIR}/data/methylbert/oac_dmr_normal_pats.list"
export METHYLBERT_CPG_FILE="/users/zetzioni/sharedscratch/wgbs_tools/references/hg38/CpG.bed.gz"
export PAT_METHYLATED_CHAR="C"
export PAT_UNMETHYLATED_CHAR="T"
export DMR_POSITION_START_BASE=1

# MethylBERT read-classifier fine-tuning:
#   T = tumour tissue BAMs
#   N = healthy-control cfDNA BAMs
export METHYLBERT_TUMOUR_BAM_LIST="${PROJECT_DIR}/data/methylbert/oac_train_tumour_bams.list"
export METHYLBERT_CONTROL_BAM_LIST="${PROJECT_DIR}/data/methylbert/oac_train_control_cfdna_bams.list"

# Bulk/test cfDNA BAMs for tumour fraction estimation.
export METHYLBERT_BULK_BAM_LIST="${PROJECT_DIR}/data/methylbert/oac_bulk_cfdna_bams.list"

# DSS DMR calling settings from the paper.
export DMR_TOP_N=100
export DMR_DELTA=0.2
export DMR_P_THRESHOLD=0.05
export DMR_MIN_CPG=4
export DMR_MIN_LEN=50
export DMR_MERGE_DISTANCE=50
export MIN_MAPQ=10
export MIN_CPG_COVERAGE=1

# Upstream MethylBERT fine-tuning settings.
export N_ENCODER=12
export SEQ_LEN=150
export BATCH_SIZE=256
export GRAD_ACCUM=4
export STEPS=600
export NUM_WORKERS=8
export LOG_FREQ=10
export EVAL_FREQ=10
export WARM_UP=100
export DECREASE_STEPS=200
export LR=4e-4
export LOSS=bce
export WITH_CUDA=1

# Deconvolution.
export DECONV_BATCH_SIZE=128
export ADJUSTMENT=1
