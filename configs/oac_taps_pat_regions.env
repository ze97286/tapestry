#!/bin/bash
# Sourceable configuration for OAC hg38 TAPS/PAT region selection.
#
# This is the module/R path used by the original deepconv atlas workflow.  It
# does not require methylation-tagged BAMs.  All coordinate inputs are hg38.

: "${OUTPUT_DIR:=${PROJECT_DIR}/runs/run_v0.5_taps_pat}"
export OUTPUT_DIR
: "${RUN_LABEL:=OAC_taps_pat_hg38_regions}"
export RUN_LABEL

# Coordinate assembly for CpG index, PAT index, and emitted marker regions.
: "${TAPS_PAT_ASSEMBLY:=hg38}"
export TAPS_PAT_ASSEMBLY

# MethylBERT public checkpoints are hg19-named.  This is recorded only as a
# downstream caveat; this region-selection job must remain hg38 for hg38 BAMs.
: "${METHYLBERT_PRETRAIN_ASSEMBLY:=hg19}"
export METHYLBERT_PRETRAIN_ASSEMBLY

# Modules and R library.  Keep R module-driven, matching the cluster workflow.
: "${TAPS_PAT_MODULE_INIT:=}"
export TAPS_PAT_MODULE_INIT
: "${TAPS_PAT_R_MODULES:=r/4.5.2/gcc-15.2.0/a-itkcro5}"
export TAPS_PAT_R_MODULES
: "${TAPS_PAT_R_LIBS:=${HOME}/R/library}"
export TAPS_PAT_R_LIBS

# Original deepconv atlas code and hg38 inputs.
: "${DEEPCONV_DIR:=/users/zetzioni/sharedscratch/deepconv}"
export DEEPCONV_DIR
: "${TAPS_PAT_GENERATE_ATLAS_R:=${DEEPCONV_DIR}/src/deep_conv/atlas/generate_atlas.R}"
export TAPS_PAT_GENERATE_ATLAS_R
: "${TAPS_PAT_CPG_FILE:=/users/zetzioni/sharedscratch/wgbs_tools/references/hg38/CpG.bed.gz}"
export TAPS_PAT_CPG_FILE
: "${TAPS_PAT_BASE_DIR:=/users/zetzioni/sharedscratch/atlas}"
export TAPS_PAT_BASE_DIR
: "${TAPS_PAT_MAP_FILE:=${TAPS_PAT_BASE_DIR}/classes/per-read-bed2class.csv}"
export TAPS_PAT_MAP_FILE
: "${TAPS_PAT_INDEX_FILE:=${TAPS_PAT_BASE_DIR}/pat_index/cell_type_pat_index_l4.csv.gz}"
export TAPS_PAT_INDEX_FILE

# Main marker output, equivalent to the original deepconv command.
: "${TAPS_PAT_MARKER_DIR:=${TAPS_PAT_BASE_DIR}/markers}"
export TAPS_PAT_MARKER_DIR
: "${TAPS_PAT_OUT_FILE:=${TAPS_PAT_MARKER_DIR}/dmr_by_read.blood+gi+tum.100.l4.bed}"
export TAPS_PAT_OUT_FILE

# Selection settings from the previous cluster command.
: "${TAPS_PAT_TOP_N:=100}"
export TAPS_PAT_TOP_N
: "${TAPS_PAT_MIN_READS:=3}"
export TAPS_PAT_MIN_READS
: "${TAPS_PAT_MIN_CPGS:=4}"
export TAPS_PAT_MIN_CPGS
# generate_atlas.R uses future::multisession and loads large per-chromosome
# score files. High worker counts can OOM because multiple chromosomes are
# resident at once; raise this only with a matching high-memory allocation.
: "${TAPS_PAT_THREADS:=2}"
export TAPS_PAT_THREADS
: "${TAPS_PAT_VERBOSE:=1}"
export TAPS_PAT_VERBOSE

# Optional JSON mapping consumed by generate_atlas.R, for example:
#   export TAPS_PAT_GROUP_MAPPING='{"CD4-T-cells":"T-cells","CD8-T-cells":"T-cells"}'
: "${TAPS_PAT_GROUP_MAPPING:=}"
export TAPS_PAT_GROUP_MAPPING

# Optional prepared hg38 DMR table for later experiments. This requires Python
# with pandas, so the region-selection Slurm job leaves it off by default.
# It does not make the upstream MethylBERT BAM preprocessor work on untagged
# BAMs; it only gives a clean hg38 coordinate table if we build a PAT-derived
# reader later.
: "${TAPS_PAT_WRITE_METHYLBERT_DMRS:=0}"
export TAPS_PAT_WRITE_METHYLBERT_DMRS
: "${TAPS_PAT_METHYLBERT_TARGET:=OAC}"
export TAPS_PAT_METHYLBERT_TARGET
: "${TAPS_PAT_METHYLBERT_TOP_N:=100}"
export TAPS_PAT_METHYLBERT_TOP_N
: "${TAPS_PAT_METHYLBERT_DMRS:=${OUTPUT_DIR}/methylbert/${RUN_LABEL}/dmrs_oac_hg38.tsv}"
export TAPS_PAT_METHYLBERT_DMRS
