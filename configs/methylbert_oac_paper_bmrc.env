#!/bin/bash
# BMRC-focused config for the PAT-only DSS DMR step.
#
# This deliberately does not load the cortex3 Python/R/libxml2 modules from
# methylbert_oac_paper.env. Load BMRC R/Python modules in your shell or edit the
# module variables below before submitting the PAT DMR job.

if [ -z "${PROJECT_DIR:-}" ]; then
    PROJECT_DIR="$(pwd)"
    export PROJECT_DIR
fi

_methylbert_bmrc_unset="__METHYLBERT_BMRC_UNSET__"
_methylbert_bmrc_module_init="${METHYLBERT_MODULE_INIT-${_methylbert_bmrc_unset}}"
_methylbert_bmrc_module_use="${METHYLBERT_MODULE_USE-${_methylbert_bmrc_unset}}"
_methylbert_bmrc_modules="${METHYLBERT_MODULES-${_methylbert_bmrc_unset}}"
_methylbert_bmrc_dmr_modules="${METHYLBERT_DMR_MODULES-${_methylbert_bmrc_unset}}"
_methylbert_bmrc_setup_modules="${METHYLBERT_SETUP_MODULES-${_methylbert_bmrc_unset}}"

source "${PROJECT_DIR}/configs/methylbert_oac_paper.env"

export RUN_LABEL="OAC_methylbert_paper_bmrc"
export OUTPUT_DIR="${METHYLBERT_BMRC_OUTPUT_DIR:-${PROJECT_DIR}/runs/run_v0.5_methylbert_bmrc}"
export METHYLBERT_WORK_DIR="${OUTPUT_DIR}/methylbert/${RUN_LABEL}"

export METHYLBERT_REF_FASTA=""
export METHYLBERT_REF_FASTA_GZ="${METHYLBERT_BMRC_REF_FASTA_GZ:-/well/ludwig/shared/genomes/hg38_full_gatk_HPV_HBV_HCV_spike-ins_v2.fa.gz}"

export METHYLBERT_R_LIBS="${HOME}/R/library"
export METHYLBERT_ENV_COMMAND='export R_LIBS_USER="${METHYLBERT_R_LIBS}"'
export METHYLBERT_VENV_SCOPE="none"
export METHYLBERT_SETUP_R_DEPS=1
export METHYLBERT_DEACTIVATE_CONDA=1
export METHYLBERT_PREPROCESS_PAT_MODULES="${METHYLBERT_BMRC_PREPROCESS_PAT_MODULES:-Python/3.11.3-GCCcore-12.3.0}"

# The PAT/DSS step only needs Rscript, DSS, and optparse on PATH. Default to no
# cortex3-specific modules, but preserve BMRC module settings provided by the
# caller before this config is sourced.
if [ "${_methylbert_bmrc_module_init}" != "${_methylbert_bmrc_unset}" ]; then
    export METHYLBERT_MODULE_INIT="${_methylbert_bmrc_module_init}"
else
    export METHYLBERT_MODULE_INIT="${METHYLBERT_BMRC_MODULE_INIT:-}"
fi

if [ "${_methylbert_bmrc_module_use}" != "${_methylbert_bmrc_unset}" ]; then
    export METHYLBERT_MODULE_USE="${_methylbert_bmrc_module_use}"
else
    export METHYLBERT_MODULE_USE="${METHYLBERT_BMRC_MODULE_USE:-}"
fi

if [ "${_methylbert_bmrc_modules}" != "${_methylbert_bmrc_unset}" ]; then
    export METHYLBERT_MODULES="${_methylbert_bmrc_modules}"
else
    export METHYLBERT_MODULES="${METHYLBERT_BMRC_MODULES:-}"
fi

if [ "${_methylbert_bmrc_setup_modules}" != "${_methylbert_bmrc_unset}" ]; then
    export METHYLBERT_SETUP_MODULES="${_methylbert_bmrc_setup_modules}"
else
    export METHYLBERT_SETUP_MODULES="${METHYLBERT_BMRC_SETUP_MODULES:-}"
fi

if [ "${_methylbert_bmrc_dmr_modules}" != "${_methylbert_bmrc_unset}" ]; then
    export METHYLBERT_DMR_MODULES="${_methylbert_bmrc_dmr_modules}"
else
    export METHYLBERT_DMR_MODULES="${METHYLBERT_BMRC_DMR_MODULES:-${METHYLBERT_SETUP_MODULES}}"
fi

export METHYLBERT_DMR_TUMOUR_PAT_LIST="${PROJECT_DIR}/data/methylbert/oac_dmr_tumour_pats.list"
export METHYLBERT_DMR_NORMAL_PAT_LIST="${PROJECT_DIR}/data/methylbert/oac_dmr_normal_pats.list"
export METHYLBERT_CPG_FILE="${PROJECT_DIR}/data/CpG.bed.gz"

export PAT_METHYLATED_CHAR="C"
export PAT_UNMETHYLATED_CHAR="T"
export DMR_POSITION_START_BASE=1
