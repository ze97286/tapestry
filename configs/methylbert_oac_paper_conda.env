#!/bin/bash
# Sourceable configuration overlay for running the MethylBERT paper pipeline
# from a pinned conda prefix instead of compiling R/Bioconductor packages
# against cluster modules.

_methylbert_config_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${_methylbert_config_dir}/methylbert_oac_paper.env"

export METHYLBERT_CONDA_PREFIX="${OUTPUT_DIR}/envs/methylbert_dmr_conda"
export METHYLBERT_CONDA_ENV_YML="${PROJECT_DIR}/configs/methylbert_dmr_conda.yml"

# Module used only to expose conda/mamba while creating the prefix. If the
# command is already on PATH this can be left empty by the caller.
export METHYLBERT_CONDA_MODULES="${METHYLBERT_CONDA_MODULES:-Miniforge3/24.11.3-0}"

# Do not load the site Python/R/samtools modules for MethylBERT jobs when using
# the conda prefix. The prefix supplies python, pysam, samtools, Rscript, DSS,
# and optparse as one consistent runtime.
export METHYLBERT_MODULES=""
export METHYLBERT_DMR_MODULES=""
export METHYLBERT_SETUP_MODULES=""
export METHYLBERT_SETUP_R_DEPS=0

export METHYLBERT_ENV_COMMAND='export PATH="${METHYLBERT_CONDA_PREFIX}/bin:${PATH}"'
